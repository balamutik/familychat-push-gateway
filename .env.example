PUSH_HTTPS_PORT=9443
# Configure the providers required by the installed FamilyChat builds.
APNS_KEY_FILE=/run/gateway-secrets/apns.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=com.familychat.FamilyChatSelfhosted
APNS_SANDBOX=false
# Remove all four APNS_* identity settings above for Android-only installations.
# FCM_CREDENTIALS_FILE=/run/gateway-secrets/fcm.json
# FCM_PROJECT_ID=your-firebase-project
# FCM_APPLICATION_ID=com.familychat.android
